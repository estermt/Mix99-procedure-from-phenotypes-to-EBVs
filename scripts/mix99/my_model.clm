TITLE Animal Model: methane production

DATAFILE renum2500_5488.dat
INTEGER  animal BLOQUE EL60250 numlact calmonth cogrnu
REAL meanppm meangd
MISSING -999.9
iGFILE LOWER iHL_5488.bin
#iA22FILE PEDIGREE
PEDFILE renum_pedcompleto2500_5488.ped
PEDIGREE G am
INBRFILE renum_completo2500_5488formix.inbr
INBREEDING PEDIGREECODE=1 FINBR=2
PARFILE parfile_5488  # variance file
PRECON      b b       f       # Preconditioner: b=block f=fullblock
WithinBlock  G PE
RANDOM   PE G
DATASORT  BLOCK=BLOQUE PEDIGREECODE=animal

MODEL 
meanppm = EL60250 numlact calmonth cogrnu  PE(animal) G(animal)
meangd = EL60250 numlact calmonth cogrnu  PE(animal) G(animal)
TMPDIR temp


