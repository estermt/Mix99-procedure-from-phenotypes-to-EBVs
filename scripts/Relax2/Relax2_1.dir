input pedigree 			 ## pedigree input
file pedigree.txt  	
record id $ 1:14 sire $ 16:29 dam $ 31:44 group 46:47	 # alphanumeric characters of 14 characters each one. Have into account blank space
unknown '00000000000000'
#prune prediction # this option is unmarked because I prunned with the R script in the previous step
zeroIsUnknown      # name negative progenitors as zero
input data			
file phenotypes.dat
record id $ 1:14 group  16:17
input animals                    ## Relationship for this animals
file phenotypes.dat
record id $ 1:14 group  16:17
mix99 keep # this option keep the order of pedigree
renumbered # this option renumber id and group 
output overwrite pedigree renum_ped.ped # renumbered ped
output overwrite data renum_phen.dat # the new data renumbered
output overwrite inbreeding renum_inb.inbr # this file have the original id with its corresponding renumbered id
